// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String    // bcrypt hash
  role      String    @default("admin") // admin | superadmin
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Room {
  id            Int       @id @default(autoincrement())
  number        Int?      @unique
  type          String
  pricePerNight Float
  discount      Float     @default(0)  // percentage discount (0-100) shown to public
  status        String    @default("available") // available, occupied, maintenance, reserved
  description   String?
  amenities     String?   // JSON string of amenities
  images        String?   // JSON string of image paths
  bookings      Booking[]
  orders        Order[]
  maintenanceRequests MaintenanceRequest[]
  housekeepingTasks   HousekeepingTask[]
  deletedAt     DateTime? // soft-delete timestamp
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("rooms")
}

model Guest {
  id            Int       @id @default(autoincrement())
  name          String
  phone         String
  email         String    @unique
  idNumber      String?
  address       String?
  isBlacklisted Boolean   @default(false)
  bookings      Booking[]
  orders    Order[]
  payments  Payment[]
  deletedAt DateTime? // soft-delete timestamp
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("guests")
}

model Booking {
  id           Int       @id @default(autoincrement())
  guestId      Int
  roomId       Int
  startDate    DateTime
  endDate      DateTime
  checkInTime  String?
  checkOutTime String?
  bookedBy     String?
  status       String    @default("pending") // pending, confirmed, checked-in, checked-out, cancelled
  totalAmount  Float
  specialRequests String?
  actualCheckOutTime DateTime?
  lateCheckoutFee    Float?
  checkoutNotes      String?
  guest        Guest     @relation(fields: [guestId], references: [id])
  room         Room      @relation(fields: [roomId], references: [id])
  payments     Payment[]
  deletedAt    DateTime? // soft-delete timestamp
  deletedBy    String?   // admin username who soft-deleted
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("bookings")
}

model MenuItem {
  id          Int         @id @default(autoincrement())
  name        String
  category    String
  price       Float
  available   Boolean     @default(true)
  description String?
  image       String?
  orderItems  OrderItem[]
  deletedAt   DateTime?   // soft-delete timestamp
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("menu_items")
}

model Order {
  id           Int         @id @default(autoincrement())
  guestId      Int?
  roomId       Int?
  status       String      @default("pending") // pending, preparing, ready, delivered, cancelled
  totalAmount  Float
  notes        String?
  guest        Guest?      @relation(fields: [guestId], references: [id])
  room         Room?       @relation(fields: [roomId], references: [id])
  orderItems   OrderItem[]
  payments     Payment[]
  deletedAt    DateTime?   // soft-delete timestamp
  deletedBy    String?     // admin username who soft-deleted
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("orders")
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  menuItemId Int
  quantity   Int
  unitPrice  Float
  order      Order    @relation(fields: [orderId], references: [id])
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  createdAt  DateTime @default(now())

  @@map("order_items")
}

model Payment {
  id           Int      @id @default(autoincrement())
  amount       Float
  method       String   // card, cash, transfer, etc.
  reference    String?  // transaction reference
  status       String   @default("pending") // pending, completed, failed, refunded
  bookingId    Int?
  orderId      Int?
  guestId      Int
  booking      Booking? @relation(fields: [bookingId], references: [id])
  order        Order?   @relation(fields: [orderId], references: [id])
  guest        Guest    @relation(fields: [guestId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("payments")
}

model Review {
  id           Int      @id @default(autoincrement())
  guestName    String
  guestEmail   String?
  guestType    String?  // business, leisure, family, etc.
  rating       Int      // 1-5 stars
  title        String?
  content      String
  highlights   String?
  suggestions  String?
  status       String   @default("pending") // pending, approved, rejected
  featured     Boolean  @default(false)
  deletedAt    DateTime? // soft-delete timestamp
  deletedBy    String?   // admin username who soft-deleted
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("reviews")
}

// ============================================================
// SUPER ADMIN — Permanent record of all soft-deleted items
// ============================================================
model DeletedRecord {
  id           Int      @id @default(autoincrement())
  recordType   String   // booking | order | guest | menuItem | room | review
  recordId     Int      // original record's ID
  snapshot     String   // Full JSON snapshot of the record at time of deletion
  deletedBy    String   // admin username who triggered the delete
  deletedAt    DateTime @default(now())
  isRead       Boolean  @default(false)  // has super admin viewed this notification?
  restoredAt   DateTime?  // set if super admin restored it
  restoredBy   String?    // superadmin username who restored
  purgedAt     DateTime?  // set if permanently destroyed by super admin
  purgedBy     String?    // superadmin username who purged

  @@map("deleted_records")
}

model ContentSection {
  id          Int      @id @default(autoincrement())
  page        String   // home, about, rooms, etc.
  section     String   // hero, about, features, etc.
  title       String?
  subtitle    String?
  content     String?
  images      String?  // JSON string of image paths
  metadata    String?  // JSON string for additional data
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([page, section])
  @@map("content_sections")
}

model SiteSettings {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  type        String   @default("text") // text, number, boolean, json, image
  category    String   @default("general") // general, contact, social, booking, etc.
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("site_settings")
}

model Staff {
  id                    Int              @id @default(autoincrement())
  staffCode             String?          @unique // e.g. GLH-001
  name                  String
  email                 String?          @unique
  phone                 String?
  role                  String           // Position / job title
  department            String           // Front Office, Housekeeping, Kitchen, Security, etc.
  status                String           @default("active") // active, on_leave, on_vacation, suspended, resigned, terminated
  hireDate              DateTime?        // Employment start date
  endDate               DateTime?        // Exit / resignation / termination date
  salary                Float?           // Monthly salary in NGN
  shift                 String?          // e.g. Morning (7am-3pm), Night, Day, etc.
  workDays              String?          // e.g. Mon - Fri, Rotational
  address               String?          // Residential address
  photoUrl              String?          // Passport / avatar photo URL
  idCardUrl             String?          // Uploaded ID document URL
  idType                String?          // National ID, NIN, Voters Card, Drivers License, Passport
  signatureUrl          String?          // Signature image URL
  guarantorName         String?
  guarantorPhone        String?
  guarantorAddress      String?
  guarantorRelationship String?
  bankName              String?
  accountNumber         String?
  accountName           String?
  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String?          // Management notes, disciplinary records, remarks
  permissions           String?          // JSON string of permissions
  incentives            StaffIncentive[]
  deletedAt             DateTime?        // Soft delete timestamp
  deletedBy             String?          // Admin username who soft-deleted
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@map("staff")
}

model StaffIncentive {
  id            Int      @id @default(autoincrement())
  staffId       Int
  amount        Float
  reason        String   // Performance, Overtime, Customer Commendation, Holiday Bonus, etc.
  date          DateTime @default(now())
  paymentMethod String?  // Cash, Transfer, Payroll Addition
  notes         String?
  recordedBy    String?  // Superadmin username
  staff         Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("staff_incentives")
}


model MaintenanceRequest {
  id          Int      @id @default(autoincrement())
  roomId      Int?
  title       String
  description String
  priority    String   @default("medium") // low, medium, high, urgent
  status      String   @default("pending") // pending, in_progress, completed, cancelled
  assignedTo  String?
  reportedBy  String
  estimatedCost Float?
  actualCost  Float?
  completedAt DateTime?
  room        Room?    @relation(fields: [roomId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("maintenance_requests")
}

model HousekeepingTask {
  id          Int      @id @default(autoincrement())
  roomId      Int?
  taskType    String   // cleaning, maintenance, inspection
  description String
  status      String   @default("pending") // pending, in_progress, completed
  assignedTo  String?
  priority    String   @default("normal") // low, normal, high
  estimatedTime Int?   // in minutes
  completedAt DateTime?
  notes       String?
  room        Room?    @relation(fields: [roomId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("housekeeping_tasks")
}

// ============================================================
// FINANCIAL MODULE — Expenses & Other Income
// ============================================================

model Expense {
  id            Int       @id @default(autoincrement())
  category      String    // Salaries, Fuel, Generator, Utilities, Internet, etc.
  amount        Float
  description   String
  date          DateTime
  paymentMethod String    // Cash, Transfer, POS, Cheque
  receiptUrl    String?   // optional Supabase Storage URL
  notes         String?
  recordedBy    String    // superadmin username
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("expenses")
}

model OtherIncome {
  id            Int       @id @default(autoincrement())
  source        String    // Late Checkout Fee, Smoking Fee, Damages, Laundry, Miscellaneous
  amount        Float
  description   String?
  date          DateTime
  guestRef      String?   // optional guest name / booking reference
  recordedBy    String    // superadmin username
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("other_income")
}

// ============================================================
// GUEST SELF CHECK-IN KIOSK — Arrival Log
// ============================================================
model CheckInLog {
  id               Int       @id @default(autoincrement())
  guestName        String
  phone            String
  roomNumber       String
  checkInTime      DateTime
  expectedCheckOut DateTime
  signature        String?   // Human-readable confirmation text (e.g. "Signed on tablet — T&C accepted")
  signatureUrl     String?   // Public URL of the drawn signature image (uploaded to Supabase)
  idCardUrl        String?   // Public URL of scanned / photographed ID card
  idType           String?   // National ID, Passport, Driver License, Voters Card, etc.
  ipAddress        String?
  deletedAt        DateTime?
  deletedBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  @@map("check_in_logs")
}
